-    let body_stream = response.body().ok_or(Error::MissingResponseBody)?;
-
     let trailers_only = response.headers().has("grpc-status").unwrap_or(false);
-    let body = ResponseBody::new(body_stream, &content_type, abort, trailers_only)?;
+    let body = match response.body() {
+        Some(body_stream) => ResponseBody::new(body_stream, &content_type, abort, trailers_only)?,
