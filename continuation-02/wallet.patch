diff --git a/vendor/tonic-web-wasm-client/src/fetch.rs b/vendor/tonic-web-wasm-client/src/fetch.rs
index 782e299..34240fc 100644
--- a/vendor/tonic-web-wasm-client/src/fetch.rs
+++ b/vendor/tonic-web-wasm-client/src/fetch.rs
@@ -25,7 +25,23 @@ fn js_fetch(request: &Request, init: &RequestInit) -> Promise {
 }
 
 pub async fn fetch(request: &Request, init: &RequestInit) -> Result<Response, Error> {
-    let js_response = JsFuture::from(js_fetch(request, init))
+    // The experiment uses an unresolvable logical origin. This mode must never
+    // reach the native Fetch path, even if a worker forgot to install the hook.
+    let promise = if request.url().starts_with("http://wallet-rpc.invalid/") {
+        let global = js_sys::global();
+        let hook = js_sys::Reflect::get(&global, &JsValue::from_str("__zcashProofOhttpFetch"))
+            .map_err(Error::js_error)?;
+        let hook = hook.dyn_into::<js_sys::Function>().map_err(|_| {
+            Error::JsError("OHTTP transport is not installed in this realm".into())
+        })?;
+        hook.call2(&global, request.as_ref(), init.as_ref())
+            .map_err(Error::js_error)?
+            .dyn_into::<Promise>()
+            .map_err(|_| Error::JsError("OHTTP transport did not return a Promise".into()))?
+    } else {
+        js_fetch(request, init)
+    };
+    let js_response = JsFuture::from(promise)
         .await
         .map_err(Error::js_error)?;
 
